{
  "name": "tui-coding-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests examples",
    "format:check": "prettier --check src tests examples package.json tsconfig.json eslint.config.js",
    "demo": "bun examples/runtime-demo.ts",
    "demo:node": "bun build examples/runtime-demo.ts --target=node --outfile=dist/runtime-demo.js && node dist/runtime-demo.js",
    "smoke:live": "bun examples/live-smoke.ts"
  },
  "dependencies": {
    "openai": "7.41.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
